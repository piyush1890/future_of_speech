      "isDeleted": false,
      "boundElements": [],
      "updated": 1779872499420,
      "link": null,
      "locked": false,
      "text": "“Training all layers” means the run should not freeze\nconnectors, projection layers, diffusion/acoustic\nmodules, prompt-conditioning modules, normalization\nlayers, or output heads unless we deliberately exclude\nthem.",
      "fontSize": 12.5,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "“Training all layers” means the run should not freeze connectors, projection layers, diffusion/acoustic modules, prompt-conditioning modules, normalization layers, or output heads unless we deliberately exclude them.",
